# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
# .env 는 git에 올리지 않는다(.gitignore). 키 값은 팀 채널로 따로 받는다.
# 새 환경변수를 코드에 추가하면 여기에도 키 이름과 설명을 꼭 추가한다.
# ─────────────────────────────────────────────────────────────

# ── [Anthropic] Claude API — 어드바이저 대화·임시휴무 확인(Loop A)·생성형 UI ──
ANTHROPIC_API_KEY=
# (선택) 비우면 코드 기본 모델
CHAT_MODEL=
# (선택) demo = Claude를 부르지 않고 시연용 결과 (토큰 없이 개발할 때)
LOOPA_MODE=

# ── [Google Maps Platform] ──
# 서버용 키: Routes API · Places API (New) 호출. 리퍼러 제한 없이 "API 제한"만 건다
GOOGLE_MAPS_SERVER_KEY=
# 브라우저용 키: 지도 표시. 프론트 코드에 그대로 노출되므로 반드시
#   - HTTP 리퍼러 제한: http://localhost:5173/*
#   - API 제한: Maps JavaScript API 만
VITE_GOOGLE_MAPS_BROWSER_KEY=
# 지도 ID — 우리 지도 스타일이 연결된 ID. 비우면 개발용 DEMO_MAP_ID (스타일 없음)
VITE_GOOGLE_MAPS_MAP_ID=
# 1 = Routes API 호출(결과 캐시), 0 = 고정값만 (API 비용 없이 개발할 때)
USE_ROUTES_API=1

# ── [NAVITIME] 전철 경로·시간 (RapidAPI 경유, navitime-route-totalnavi) ──
# 무료 플랜 월 500건 · 분당 50건. RapidAPI 이용규약상 결과를 파일·DB에 캐싱하면 안 된다(메모리에만)
RAPIDAPI_KEY=
# 1 = NAVITIME 호출, 0 = 전철도 고정값만 (호출 건수 아낄 때)
USE_NAVITIME=1
# 서버 한 번 켜 있는 동안 NAVITIME 호출 상한. 넘으면 전철 시간은 고정값
NAVITIME_MAX_CALLS=60

# ── [Google OAuth] 로그인 + 캘린더 쓰기 (확정하기) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── [LangGraph / LangSmith] 에이전트 서버·실행 추적 ──
LANGSMITH_API_KEY=

# ── [DB] PostgreSQL — docker compose 기본값. 로컬 개발이면 그대로 둬도 된다 ──
POSTGRES_USER=tabidori
POSTGRES_PASSWORD=tabidori
POSTGRES_DB=tabidori
DATABASE_URL=postgresql+psycopg://tabidori:tabidori@db:5432/tabidori

# ── [서비스 주소] docker compose 기본값 ──
# 프론트가 부르는 백엔드 주소 (브라우저 기준이라 localhost)
VITE_API_BASE_URL=http://localhost:8000
# 백엔드가 허용할 프론트 주소 (CORS)
CORS_ORIGINS=http://localhost:5173

# ── [날씨] Open-Meteo — 키 불필요. 테스트할 때만 가짜 서버 주소로 바꾼다 ──
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
